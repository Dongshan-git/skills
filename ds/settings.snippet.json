{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "12"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Workflow|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-Command",
              "& 'C:\\Users\\<user>\\.claude\\hooks\\enforce-agent-dispatch.ps1'; if ($null -eq $LASTEXITCODE) { exit 1 }; exit $LASTEXITCODE"
            ],
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "workflowSizeGuideline": "medium",
  "ultracode": false,
  "subagentPromptCacheTtl": "1h"
}
